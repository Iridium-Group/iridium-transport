{
  "name": "@iridium-group/transport",
  "version": "0.1.0",
  "description": "Transport abstraction for browser-based networking: direct TCP/TLS with an address policy, a Wisp v1 client, and an in-memory transport for tests.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "author": "Iridium Group contributors",
  "homepage": "https://github.com/Iridium-Group/iridium-transport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iridium-Group/iridium-transport.git"
  },
  "bugs": {
    "url": "https://github.com/Iridium-Group/iridium-transport/issues"
  },
  "keywords": [
    "transport",
    "wisp",
    "websocket",
    "tcp",
    "networking"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wisp": {
      "types": "./dist/wisp/index.d.ts",
      "import": "./dist/wisp/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./address": {
      "types": "./dist/address.d.ts",
      "import": "./dist/address.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3"
  }
}
